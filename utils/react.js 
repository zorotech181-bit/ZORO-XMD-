export default async function react(client, message) {
    const sleep = ms => new Promise(r => setTimeout(r, ms));

    const remoteJid = message?.key.remoteJid;
    if (!remoteJid) return;

    // Premye reyaksyon an (🎯)
    await client.sendMessage(remoteJid, {
        react: {
            text: '🎯',
            key: message.key
        }
    });

    await sleep(1000);

    // Dezyèm reyaksyon an (⚡)
    await client.sendMessage(remoteJid, {
        react: {
            text: '⚡',
            key: message.key
        }
    });

    await sleep(1000);

    // Retire reyaksyon an
    await client.sendMessage(remoteJid, {
        react: { 
            remove: true,
            key: message.key 
        }
    });
}
